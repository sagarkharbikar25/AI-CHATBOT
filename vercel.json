{
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm --prefix frontend install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/health",
      "destination": "https://ai-chatbot-5v0s.onrender.com/health"
    },
    {
      "source": "/api/:match*",
      "destination": "https://ai-chatbot-5v0s.onrender.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
